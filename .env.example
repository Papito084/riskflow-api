# Application Environment Configuration
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
PROJECT_NAME="RiskFlow API"

# Security & JWT
SECRET_KEY="supersecretjwtkeythatisatleast32characterslongforsecurity!"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=riskflow_user
POSTGRES_PASSWORD=riskflow_password
POSTGRES_DB=riskflow_db
DATABASE_URL=postgresql+asyncpg://riskflow_user:riskflow_password@localhost:5432/riskflow_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Analytics Cache TTL (seconds)
METRICS_CACHE_TTL_SECONDS=60

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]
